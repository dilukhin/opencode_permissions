      "base": "local_git_status",
      "mutation": {
        "kind": "set_many",
        "values": {
          "/execution/cwd/lexical": "C:/Repo/./src/..",
          "/targets/0/identity/lexical": "C:/Repo/./src/.."
        }
      },
      "expected_relation": "DIFFERENT",
      "description": "Conservative identity does not collapse dot/parent syntax because symlink/reparse resolution can change semantics."
    },
    {
