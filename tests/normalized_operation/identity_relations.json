  "case_count": 30,
  "cases": [
    {
      "id": "object_key_order",
      "base": "local_git_status",
      "mutation": {
        "kind": "reorder_object_keys"
      },
      "expected_relation": "SAME"
    },
    {
      "id": "effects_order",
      "base": "local_git_status",
      "mutation": {
        "kind": "set",
        "path": "/effects",
        "value": [
          "read",
          "git_read"
        ]
      },
      "expected_relation": "SAME"
    },
    {
      "id": "effects_duplicates",
      "base": "local_git_status",
      "mutation": {
        "kind": "set",
        "path": "/effects",
        "value": [
          "git_read",
          "read",
          "read"
        ]
      },
      "preprocess": "sort_unique_set_fields",
      "expected_relation": "SAME"
    },
    {
