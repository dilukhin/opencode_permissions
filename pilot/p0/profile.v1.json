{
  "schema": 1,
  "profile_format": "opencode-permissions-p0-classifier-profile/v1",
  "classifier_profile_id": "p0-linux-grep-single-file-v1",
  "platform": "linux",
  "allow_families": [
    "grep.single_nonsecret_workspace_file"
  ],
  "shell": {
    "path": "/bin/dash"
  },
  "python_runtime": {
    "path": "/usr/bin/python3"
  },
  "executables": {
    "grep": {
      "path": "/usr/bin/grep",
      "semantic_name": "grep"
    }
  },
  "secret_boundary": {
    "source": "policy/native/rules.v1.json",
    "permission": "read",
    "rule_id_prefix": "read.secret",
    "actions": [
      "ask",
      "deny"
    ]
  },
  "environment_dependencies": [],
  "metrics": {
    "schema": "opencode-permissions-p0-metrics/v1",
    "scope": "ask_path",
    "required_for_classifier_allow": true,
    "storage": "per_process_aggregate_snapshot",
    "state_resolution": "os_homedir_local_state",
    "raw_inputs": false,
    "max_reason_buckets": 64,
    "counters": [
      "native_ask",
      "classifier_allow",
      "classifier_deny",
      "residual_ask",
      "classifier_error/fail_closed",
      "binding_reject"
    ]
  },
  "constraints": {
    "single_simple_command_only": true,
    "exactly_one_existing_workspace_file": true,
    "recursive_search": false,
    "pipelines": false,
    "compound_shell": false,
    "redirects": false,
    "find": false,
    "git": false,
    "build_test_static_check": false,
    "state_changing": false,
    "remote": false,
    "auditor": false,
    "workspace_trust": false
  }
}
