{
  "permission": {
    "*": {
      "*": "ask"
    },
    "read": {
      "*": "allow",
      ".env.*": "ask",
      "*/.env.*": "ask",
      ".npmrc": "ask",
      "*/.npmrc": "ask",
      "*auth.json": "ask",
      ".env": "deny",
      "*/.env": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      ".netrc": "deny",
      "*/.netrc": "deny",
      ".git-credentials": "deny",
      "*/.git-credentials": "deny"
    },
    "glob": {
      "*": "allow"
    },
    "bash": {
      "pwd": "allow",
      "git status *": "allow",
      "git log -5 --oneline": "allow",
      "git show --stat HEAD": "allow",
      "git rev-parse HEAD": "allow",
      "git rev-parse --show-toplevel": "allow",
      "ssh_relay status": "allow",
      "*>*": "ask",
      "*<*": "ask",
      "bash -c *": "ask",
      "sh -c *": "ask",
      "python -c *": "ask",
      "python3 -c *": "ask",
      "node -e *": "ask",
      "powershell *-Command *": "ask",
      "pwsh *-Command *": "ask",
      "cmd /c *": "ask",
      "find *-exec*": "ask",
      "xargs *": "ask",
      "safe *": "ask",
      "python -m agent_safe *": "ask",
      "python3 -m agent_safe *": "ask",
      "ssh_relay exec *": "ask",
      "ssh_relay job *": "ask",
      "ssh_relay upload *": "ask",
      "ssh_relay download *": "ask",
      "ssh_relay --risky *": "ask",
      "rm *": "deny",
      "rmdir *": "deny",
      "Remove-Item *": "deny",
      "del *": "deny",
      "erase *": "deny",
      "find *-delete*": "deny",
      "xargs *rm*": "deny",
      "git reset --hard *": "deny",
      "git clean *-f*": "deny",
      "git clean *--force*": "deny",
      "git branch -D *": "deny",
      "git branch *--delete*--force*": "deny",
      "git push *--force*": "deny",
      "git push *-f*": "deny",
      "sudo *": "deny",
      "doas *": "deny",
      "su *": "deny",
      "Start-Process *-Verb RunAs*": "deny",
      "systemctl start *": "deny",
      "systemctl stop *": "deny",
      "systemctl restart *": "deny",
      "systemctl enable *": "deny",
      "systemctl disable *": "deny",
      "systemctl mask *": "deny",
      "sc start *": "deny",
      "sc stop *": "deny",
      "sc config *": "deny",
      "sc delete *": "deny",
      "sh": "deny",
      "bash": "deny",
      "*Invoke-Expression*": "deny",
      "iex *": "deny",
      "env": "deny",
      "env *": "deny",
      "printenv": "deny",
      "printenv *": "deny",
      "Get-ChildItem *Env:*": "deny",
      "python -c *os.remove*": "deny",
      "python3 -c *os.remove*": "deny",
      "python -c *shutil.rmtree*": "deny",
      "python3 -c *shutil.rmtree*": "deny",
      "powershell *Remove-Item*": "deny",
      "pwsh *Remove-Item*": "deny",
      "cmd /c *del *": "deny",
      "cmd /c *erase *": "deny",
      "safe *--approved*": "deny",
      "python -m agent_safe *--approved*": "deny",
      "python3 -m agent_safe *--approved*": "deny",
      "safe * rm *": "deny",
      "safe *os.remove*": "deny",
      "safe *shutil.rmtree*": "deny",
      "python -m agent_safe * rm *": "deny",
      "python3 -m agent_safe * rm *": "deny",
      "ssh_relay * rm *": "deny",
      "ssh_relay sudo-exec *": "deny"
    },
    "edit": {
      "opencode.json": "deny",
      "*/opencode.json": "deny",
      "opencode.jsonc": "deny",
      "*/opencode.jsonc": "deny",
      ".opencode/*": "deny",
      "*/.opencode/*": "deny",
      ".git/*": "deny",
      "*/.git/*": "deny"
    }
  }
}
